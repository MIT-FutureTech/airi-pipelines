#!/bin/sh

# Prevent commits to main
branch_name="$(git rev-parse --abbrev-ref HEAD)"
if [ "${branch_name}" == "main" ]
then
    echo "Commits to main are not allowed. Please see the Workflow section of the README."
    exit 1
fi

# pipeline-explorer
if git diff --cached --name-only | grep -q '^pipeline-explorer/'
then
    cd "$(git rev-parse --show-toplevel)/pipeline-explorer" || exit 1

    echo "pipeline-explorer: running biome..."
    npx @biomejs/biome check --staged --files-ignore-unknown=true --no-errors-on-unmatched || exit 1

    echo "pipeline-explorer: running typecheck..."
    npm run typecheck || exit 1
fi

# Python (toolbox + pipelines)
if git diff --cached --name-only | grep -qE '\.(py|pyi)$'
then
    cd "$(git rev-parse --show-toplevel)" || exit 1

    echo "python: running ruff format..."
    uv run ruff format --check || exit 1

    echo "python: running ruff check..."
    uv run ruff check || exit 1

    echo "python: running basedpyright..."
    uv run basedpyright || exit 1
fi
