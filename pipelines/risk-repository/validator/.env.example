# Airtable personal access token with read+write on the base below.
AIRTABLE_PAT=

# Airtable base ID
AIRTABLE_BASE_ID=app32FOUBa5WcUfEO

# Name of table containing documents to screen
AIRTABLE_DOCUMENTS_TABLE="Documents 2026"

# View on the documents table that contains the human-screening subset,
# ordered for screening.
AIRTABLE_DOCUMENTS_VIEW="Human Screening"

# Table to write screening decisions to
AIRTABLE_DECISIONS_TABLE="Documents 2026 Screening Decisions"

# Name of table containing risks to classify
AIRTABLE_RISKS_TABLE="Risks 2026"

# Table to write classification reviews to
AIRTABLE_REVIEWS_TABLE="Classification Reviews 2026"

# Table listing the papers proposed for extraction
AIRTABLE_PROPOSED_EXTRACTIONS_TABLE="Proposed Extractions"

# Optional: when set, `npm run dev` proxies /api/* to this URL instead of
# requiring local serverless functions.
# VITE_API_PROXY_TARGET=https://risk-repository-validator.vercel.app
