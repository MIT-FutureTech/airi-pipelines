{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
  "extends": ["../../../biome.base.jsonc"],
  "vcs": {
    "root": "../../.."
  },
  "linter": {
    "rules": {
      "style": {
        // Allow acronyms like URL and HTTP in camelCase/PascalCase identifiers.
        // Allow snake_case type properties (this app mirrors snake_case API data).
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "match": ".*"
              },
              {
                "selector": {
                  "kind": "typeProperty"
                },
                "formats": ["camelCase", "PascalCase", "snake_case"]
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      // Vercel serverless functions are deployed as plain .js and run as
      // Node ESM. Path aliases aren't resolved at runtime, and relative
      // imports need the .js extension matching the emitted file.
      "includes": ["api/**", "shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@shared/*", "@/*", "@api/*"],
                    "message": "Use relative imports inside api/ and shared/"
                  },
                  {
                    "group": ["./**", "../**", "!./**/*.js", "!../**/*.js"],
                    "message": "Relative imports inside api/ and shared/ must end with .js"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
