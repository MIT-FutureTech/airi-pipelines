{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/screening", "destination": "/index.html" },
    { "source": "/papers", "destination": "/index.html" },
    { "source": "/papers/:quickRef", "destination": "/index.html" }
  ]
}
