{
  "name": "validator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:vercel": "vercel dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
