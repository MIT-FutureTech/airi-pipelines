    "react-dom": "19.2.4",
    "react-error-boundary": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/node": "^5.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "postcss": "^8.4.49",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5",
    "vercel": "^54.0.0",
    "vite": "^6.0.0"
