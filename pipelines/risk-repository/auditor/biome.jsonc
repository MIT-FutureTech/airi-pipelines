{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
  "extends": ["../../../biome.base.jsonc"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": "../../.."
  },
  "linter": {
    "rules": {
      "correctness": {
        // Biome can't resolve tsconfig path aliases (@/)
        "noUnresolvedImports": "off"
      }
    }
  }
}
