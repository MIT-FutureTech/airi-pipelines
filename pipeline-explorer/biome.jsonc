{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
  "extends": ["../biome.base.jsonc"],
  "vcs": {
    "root": ".."
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      // Next.js requires default exports for pages, layouts, and config files
      "includes": [
        "next.config.ts",
        "postcss.config.mjs",
        "mdx-components.tsx",
        "src/app/**/page.tsx",
        "src/app/**/layout.tsx",
        "src/app/**/loading.tsx",
        "src/app/**/error.tsx",
        "src/app/**/not-found.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
