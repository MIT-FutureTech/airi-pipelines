{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": ".."
  },
  "files": {
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        // Import extensions are non-standard for Next.js apps
        "useImportExtensions": "off",
        // Biome can't resolve tsconfig path aliases (@/)
        "noUnresolvedImports": "off"
      },
      "suspicious": {
        // This app uses React, so React-specific properties are expected
        "noReactSpecificProps": "off"
      },
      "style": {
        "useBlockStatements": "error",
        // Allow acronyms like MDX, URL in camelCase/PascalCase identifiers
        "useNamingConvention": {
          "level": "error",
          "options": { "strictCase": false }
        },
        // This app is English-only; no i18n needed
        "noJsxLiterals": "off"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "overrides": [
    {
      // Next.js requires default exports for pages, layouts, and config files
      "includes": [
        "next.config.ts",
        "postcss.config.mjs",
        "mdx-components.tsx",
        "src/app/**/page.tsx",
        "src/app/**/layout.tsx",
        "src/app/**/loading.tsx",
        "src/app/**/error.tsx",
        "src/app/**/not-found.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
