{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
  "files": {
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        // These apps use React, so React-specific properties are expected
        "noReactSpecificProps": "off"
      },
      "style": {
        "useBlockStatements": "error",
        "useNamingConvention": {
          "level": "error",
          // Allow acronyms like URL and HTTP in camelCase/PascalCase identifiers
          "options": { "strictCase": false }
        },
        // These apps are English-only; no i18n needed
        "noJsxLiterals": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
